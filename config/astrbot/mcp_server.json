{
  "mcpServers": {
    "obsidian": {
      "active": true,
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "https://127.0.0.1:27124/mcp/",
        "--header",
        "Authorization: Bearer <REDACTED:obsidian-token>"
      ],
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      }
    }
  }
}